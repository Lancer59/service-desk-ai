# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# ── Azure OpenAI (required) ───────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── ServiceNow ────────────────────────────────────────────────────────────────
SERVICENOW_DOMAIN=https://your-instance.service-now.com
SERVICENOW_USER=your-servicenow-username
SERVICENOW_PASSWORD=your-servicenow-password
# State value used when closing an incident (platform-specific, e.g. "6" = Resolved)
SERVICENOW_CLOSE_STATE=6

# ── Microsoft Graph / Entra ID ────────────────────────────────────────────────
GRAPH_TENANT_ID=your-entra-tenant-id
GRAPH_CLIENT_ID=your-app-client-id
GRAPH_CLIENT_SECRET=your-app-client-secret
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# Email of the organizer user for Teams calendar events
GRAPH_ORGANIZER_USER=organizer@yourdomain.com

# ── Nexthink ──────────────────────────────────────────────────────────────────
NEXTHINK_URL=https://your-nexthink-instance.nexthink.cloud
NEXTHINK_TOKEN_URL=https://your-nexthink-instance.nexthink.cloud/api/v1/token
# basic | client_credentials
NEXTHINK_AUTH_MODE=client_credentials
NEXTHINK_CLIENT_ID=your-nexthink-client-id
NEXTHINK_CLIENT_SECRET=your-nexthink-client-secret
# Only needed for basic auth mode:
# NEXTHINK_USERNAME=your-username
# NEXTHINK_PASSWORD=your-password
# Remote action endpoint (confirm with Nexthink team)
NEXTHINK_ACTION_ENDPOINT=/api/v1/remote-actions/execute

# ── Internal VM / Azure Orchestration API ────────────────────────────────────
VM_API_URL=https://your-internal-platform/api/v2.0/azure

# ── Node / Notification Server ────────────────────────────────────────────────
NODE_SERVER_URL=https://your-node-server
# Public URL of THIS service (used to build approval callback links)
PUBLIC_SERVICE_DESK_URL=http://localhost:8000

# ── MongoDB (approval persistence) ───────────────────────────────────────────
MONGO_URL=mongodb://user:password@your-mongo-host:27017
MONGO_DB_NAME=service_desk

# ── SMTP (email notifications) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-app-password

# ── Zoom ──────────────────────────────────────────────────────────────────────
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# ── Google Calendar / Meet ────────────────────────────────────────────────────
# Path to Google service account JSON key file (domain-wide delegation required)
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
# Email of the user to impersonate for calendar events
GOOGLE_CALENDAR_DELEGATE=calendar-user@yourdomain.com

# ── Optional overrides (defaults come from config.yaml) ───────────────────────
# MEMORY_BACKEND=memory        # memory | redis | postgres
# LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
